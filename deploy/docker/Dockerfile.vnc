# Imagen OPCIONAL para hacer el login manual de Reuters en un servidor SIN pantalla:
# expone el display virtual por noVNC, así abres un navegador y resuelves el login
# (y el deslizador de DataDome) a mano desde tu equipo.
#
# Construir sobre la imagen base (arriba):
#   docker build -t newsphotostalker     -f deploy/docker/Dockerfile .
#   docker build -t newsphotostalker-vnc -f deploy/docker/Dockerfile.vnc deploy/docker
# Ejecutar (mismo volumen de datos que la app, para compartir el perfil de Reuters):
#   docker run --rm --init -p 6080:6080 -v "$PWD/data":/srv/app/data newsphotostalker-vnc
# Luego abre  http://SERVIDOR:6080/vnc.html  y haz el login.
FROM newsphotostalker:latest
RUN apt-get update \
 && apt-get install -y --no-install-recommends x11vnc novnc websockify \
 && rm -rf /var/lib/apt/lists/*
EXPOSE 6080
CMD ["sh","-c","rm -f /tmp/.X99-lock; rm -rf /tmp/.X11-unix/X99; Xvfb :99 -screen 0 1440x900x24 -nolisten tcp & x11vnc -display :99 -localhost -nopw -forever -shared -quiet & websockify --web /usr/share/novnc 6080 localhost:5900 & export DISPLAY=:99; sleep 2; exec python -m scripts.login_reuters"]
